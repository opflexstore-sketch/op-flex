# ============================================================================
# EmailJS — sends signup OTPs straight from the browser, no backend required.
# ============================================================================
#
# Setup (≈3 minutes, free tier covers 200 emails/month):
#
# 1. Sign up at https://www.emailjs.com/   (Google sign-in works)
#
# 2. Add an Email Service:
#    Dashboard → Email Services → Add New Service
#    Pick "Gmail" (easiest), connect your Google account, save.
#    Copy the SERVICE ID (looks like `service_xxxxxxx`).
#
# 3. Create an Email Template:
#    Dashboard → Email Templates → Create New Template
#    Subject:  Your {{app_name}} verification code
#    To Email: {{to_email}}
#    Body:
#       Hey {{to_name}},
#
#       Your {{app_name}} verification code is:
#
#       {{otp}}
#
#       This code expires in 5 minutes. If you didn't request this, ignore.
#
#    Save. Copy the TEMPLATE ID (looks like `template_xxxxxxx`).
#
# 4. Grab your Public Key:
#    Account → General → Public Key (looks like a 16-char string).
#
# 5. Paste all three into a `.env` file in this directory (next to package.json):
#       cp .env.example .env
#    then edit .env with your real values.
#
# 6. Restart the dev server (`npm run dev`) — Vite only reads env on startup.
# ============================================================================

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Second EmailJS template for order confirmation emails.
VITE_EMAILJS_ORDER_TEMPLATE_ID=

# Admin email — receives its own copy of every OTP + order email (separate
# send, not BCC). Leave blank to disable admin copies.
VITE_ADMIN_EMAIL=

# ============================================================================
# UPI payment details
# ============================================================================
#
# The simplest payment flow: customer clicks "Pay with UPI" → their phone
# opens PhonePe / GPay / Paytm with the amount pre-filled → they tap to
# pay → money lands in YOUR bank account associated with this UPI ID.
#
# No gateway. No fees. No KYC. No backend.
#
# How to get a UPI ID (if you don't already have one):
# 1. Install any UPI app — PhonePe, GPay, Paytm, BHIM, or your bank's app.
# 2. Set it up against your bank account. You'll be given a VPA like:
#       9876543210@ybl       (PhonePe)
#       yourname@okhdfcbank  (GPay)
#       yourname@paytm       (Paytm)
# 3. Paste it below.
#
# Trade-off: payment verification is manual. You confirm in your UPI app
# that the order amount + reference number landed before shipping.
VITE_UPI_ID=
VITE_UPI_PAYEE_NAME=OP Flex
